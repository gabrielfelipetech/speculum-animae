# Site / public runtime
NUXT_SITE_URL=http://127.0.0.1:5171

# Supabase (set your project values)
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Billing provider: "mock" or "stripe"
BILLING_PROVIDER=mock

# Stripe (required when BILLING_PROVIDER is not mock)
